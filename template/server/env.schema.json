<% const includeTenant = includeTenantAdmin || includeTenantClient; const includeSyncOrg = includeTenant && (includeDingtalk || includeWecom); %>{
  "type": "object",
  "required": [],
  "properties": {
    "DB_DIALECT": { "type": "string", "default": "sqlite", "description": "数据库类型：生产用 postgres；sqlite 仅本地开发（sqlite3 在 devDependencies，生产安装不含）" },
    "DB_HOST": { "type": "string", "default": "data.db", "description": "数据库地址，sqlite 时为数据文件路径" },
    "DB_PORT": { "type": "number", "description": "数据库端口" },
    "DB_USERNAME": { "type": "string", "description": "数据库用户名" },
    "DB_PASSWORD": { "type": "string", "writeOnly": true, "description": "数据库密码" },
    "DB_DATABASE": { "type": "string", "description": "数据库名" },
    "ENV": { "type": "string", "default": "prod", "description": "运行环境：staging 使用 entry.html，prod 使用 entry-prod.html，其它使用 index.html" },
    "PORT": { "type": "number", "default": <%=port%>, "description": "服务监听端口" },
    "IS_TEST": { "type": "boolean", "default": false, "description": "为 true 时消息不真正发送，账号接口返回验证码和重置令牌；线上保持 false" },
    "ORIGIN": { "type": "string", "default": "<% if (includeOidc) { %>http://localhost:3040<% } %>", "description": "站点访问地址，用于生成邮件中的链接<% if (includeOidc) { %>；也是 OIDC 的 origin，正式部署需改为对外地址<% } %>" },<% if (includeOidc) { %>
    "AUTH_MODE": { "type": "string", "enum": ["standalone", "central"], "description": "统一登录模式：standalone 自带 IdP，central 使用主项目 IdP；部署到应用中心时由宿主注入。不要写 default，应用中心会据此认为应用要保持自己的登录而不注入；本地未配置时由 server.js 兜底为 standalone" },
    "OIDC_IS_MAIN": { "type": "string", "default": "false", "description": "是否为主系统（其它子项目以本项目为 IdP），仅 standalone 有效；应用中心注入" },
    "OIDC_KEY_SECRET": { "type": "string", "writeOnly": true, "description": "standalone 模式下加密签名私钥与 client_secret 的密钥；生产必须由应用中心注入，不可使用默认值" },
    "OIDC_COOKIE_SECRET": { "type": "string", "writeOnly": true, "description": "OIDC 交互 cookie 签名密钥；未配置时由 OIDC_KEY_SECRET 派生" },
    "OIDC_ISSUER": { "type": "string", "description": "主项目 issuer（central 模式必填，须带路径，如 https://main.example.com/oidc）" },
    "OIDC_CLIENT_ID": { "type": "string", "default": "oidc-spa", "description": "本项目 SPA 的 client_id，须与前端 createOidcClient 的 clientId 一致" },
    "OIDC_AUDIENCE": { "type": "string", "description": "本项目 API 资源标识，默认 ${ORIGIN}/api；须与前端 resource 一致" },
    "OIDC_SERVICE_CLIENT_ID": { "type": "string", "description": "服务端 client id（central 模式拉取用户资料与租户信息）" },
    "OIDC_SERVICE_CLIENT_SECRET": { "type": "string", "writeOnly": true, "description": "服务端 client secret（central 模式）" },<% } %><% if (includeOss) { %>
    "OSS_REGION": { "type": "string", "description": "阿里云 OSS 区域；OSS_* 四项都填写时上传文件存 OSS，否则存本地 static" },
    "OSS_BUCKET": { "type": "string", "description": "阿里云 OSS Bucket" },
    "OSS_ACCESS_KEY_ID": { "type": "string", "description": "阿里云 AccessKey ID" },
    "OSS_ACCESS_KEY_SECRET": { "type": "string", "writeOnly": true, "description": "阿里云 AccessKey Secret" },<% } %><% if (includeSyncOrg) { %>
    "SYNC_ORG_SECRET": { "type": "string", "writeOnly": true, "description": "组织架构同步服务密钥" },
    "SYNC_ORG_HOST": { "type": "string", "description": "组织架构同步服务地址" },<% } %>
    "ALISMTP_USER": { "type": "string", "description": "邮件发送账号" },
    "ALISMTP_PASSWORD": { "type": "string", "writeOnly": true, "description": "邮件发送密码" },
    "ALISMTP_ENDPOINT": { "type": "string", "description": "邮件 SMTP 服务地址" }
  }
}
