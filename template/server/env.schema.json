<% const includeTenant = includeTenantAdmin || includeTenantClient; const includeSyncOrg = includeTenant && (includeDingtalk || includeWecom); %>{
  "type": "object",
  "required": [<% if (includeOss) { %>"OSS_REGION", "OSS_BUCKET", "OSS_ACCESS_KEY_ID", "OSS_ACCESS_KEY_SECRET"<% } %>],
  "properties": {
    "DB_DIALECT": { "type": "string", "default": "sqlite", "description": "数据库类型，如 sqlite、mysql、postgres" },
    "DB_HOST": { "type": "string", "default": "data.db", "description": "数据库地址，sqlite 时为数据文件路径" },
    "DB_PORT": { "type": "number", "description": "数据库端口" },
    "DB_USERNAME": { "type": "string", "description": "数据库用户名" },
    "DB_PASSWORD": { "type": "string", "writeOnly": true, "description": "数据库密码" },
    "DB_DATABASE": { "type": "string", "description": "数据库名" },
    "ENV": { "type": "string", "default": "local", "description": "运行环境：staging 使用 entry.html，prod 使用 entry-prod.html，其它使用 index.html" },
    "PORT": { "type": "number", "default": <%=port%>, "description": "服务监听端口" },
    "ORIGIN": { "type": "string", "default": "", "description": "站点访问地址，用于生成邮件中的链接" },<% if (includeOss) { %>
    "OSS_REGION": { "type": "string", "description": "阿里云 OSS 区域" },
    "OSS_BUCKET": { "type": "string", "description": "阿里云 OSS Bucket" },
    "OSS_ACCESS_KEY_ID": { "type": "string", "description": "阿里云 AccessKey ID" },
    "OSS_ACCESS_KEY_SECRET": { "type": "string", "writeOnly": true, "description": "阿里云 AccessKey Secret" },<% } %><% if (includeSyncOrg) { %>
    "SYNC_ORG_SECRET": { "type": "string", "writeOnly": true, "description": "组织架构同步服务密钥" },
    "SYNC_ORG_HOST": { "type": "string", "description": "组织架构同步服务地址" },<% } %>
    "ALISMTP_USER": { "type": "string", "description": "邮件发送账号" },
    "ALISMTP_PASSWORD": { "type": "string", "writeOnly": true, "description": "邮件发送密码" },
    "ALISMTP_ENDPOINT": { "type": "string", "description": "邮件 SMTP 服务地址" }
  }
}
